{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "@collab/api —— NestJS 后端：认证、房间、画布、实时网关",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@collab/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "ioredis": "^5.4.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.0",
    "@types/pg": "^8.16.0",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.0"
  }
}
