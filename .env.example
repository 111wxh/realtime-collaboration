# 运行环境
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL（docker compose 起的本地依赖；宿主端口 5433，避开本机可能已有的 5432）
DATABASE_URL=postgresql://app:app@localhost:5433/collab

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL=30d

# 实时通道
WS_MAX_BUFFER=1048576
OPLOG_RETENTION_DAYS=7

# Presence（可选，都有默认值：TTL 60s / 20s 续期一次）
# PRESENCE_TTL_SECONDS=60
# PRESENCE_TOUCH_INTERVAL_MS=20000

# Cookie Secure 覆盖（可选）：不配置时跟随请求协议（http 不加、https 加），
# 本地全栈 compose（http://localhost）无需配置
# COOKIE_SECURE=false

# 日志
LOG_LEVEL=info

# 前端（NEXT_PUBLIC_ 前缀的会被打进浏览器包，禁止放密钥）
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
# 容器内 web 的 /api 代理目标（docker compose 全栈时用，= http://api:3001）
# API_INTERNAL_URL=http://api:3001
# 镜像构建时的 npm 源（可选；本机直连 npmjs 慢时用，如 https://registry.npmmirror.com）
# NPM_REGISTRY=
